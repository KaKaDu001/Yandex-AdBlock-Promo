{
  "manifest_version": 3,
  "name": "Yandex AdBlock Promo",
  "version": "1.0.0",
  "description": "Скрывает результаты поиска с пометкой 'промо' на странице поиска Яндекса",
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://yandex.ru/search/*",
        "*://www.yandex.ru/search/*",
        "*://yandex.com/search/*",
        "*://www.yandex.com/search/*",
        "*://ya.ru/search/*",
        "*://www.ya.ru/search/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}

